{
  "manifest_version": 3,
  "name": "种植园尨译助手",
  "version": "0.1.0",
  "description": "面向种植园汉化组组员的尨译工作助手",
  "author": "OuKaTsuki",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "cookies",
    "scripting",
    "alarms",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "avatar_referer_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://moetran.com/*",
    "https://api.moetran.com/*",
    "https://*.m-t.pics/*",
    "https://c01.m-t.pics/*",
    "https://*.weblio.jp/*",
    "https://*.mojidict.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:;"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "img/cotton.png",
      "32": "img/cotton.png",
      "48": "img/cotton.png",
      "64": "img/cotton.png",
      "128": "img/cotton.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "img/cotton.png",
    "32": "img/cotton.png",
    "48": "img/cotton.png",
    "64": "img/cotton.png",
    "128": "img/cotton.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moetran.com/*"
      ],
      "js": [
        "theme-preloader.js"
      ],
      "css": [
        "moetran-theme.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://moetran.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/icon.png",
        "img/icon-white.png"
      ],
      "matches": [
        "https://moetran.com/*"
      ]
    }
  ]
}